# Keep repository text files consistent across Windows and Linux.
* text=auto

# Source code and deployment/configuration files use LF in Git.
*.cs text eol=lf
*.csproj text eol=lf
*.slnx text eol=lf
*.ts text eol=lf
*.tsx text eol=lf
*.js text eol=lf
*.mjs text eol=lf
*.css text eol=lf
*.json text eol=lf
*.yml text eol=lf
*.yaml text eol=lf
*.md text eol=lf
Dockerfile text eol=lf
*.sh text eol=lf

# PowerShell scripts conventionally use Windows line endings.
*.ps1 text eol=crlf

# Binary assets must never be normalized as text.
*.ico binary
*.png binary
*.jpg binary
*.jpeg binary
*.gif binary
*.pdf binary
*.dll binary
*.pdb binary
