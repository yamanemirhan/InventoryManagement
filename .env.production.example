# Server reference template; not required for local development.
# oracle-server.py generates private runtime files. Never overwrite existing credentials with blanks.
APP_DB_PASSWORD=
DATABASE_CONNECTION_STRING=
APP_ORIGIN=https://inventory-yamanemirhan.duckdns.org
KEYCLOAK_URL=https://inventory-yamanemirhan.duckdns.org/identity
KEYCLOAK_AUTHORITY=https://inventory-yamanemirhan.duckdns.org/identity/realms/inventory-production
GOOGLE_LOGIN_ENABLED=false
# Optional public demo: provision a dedicated, non-admin account with synthetic data first.
DEMO_LOGIN_ENABLED=false
DEMO_LOGIN_EMAIL=
DEMO_LOGIN_PASSWORD=
# Invitation email: bootstrap encodes the matching identity SMTP settings.
# Base64 is encoding, not encryption; populated values are secrets.
MAIL_HOST_BASE64=
MAIL_PORT_BASE64=
MAIL_USERNAME_BASE64=
MAIL_PASSWORD_BASE64=
MAIL_FROM_BASE64=
MAIL_IMPLICITTLS_BASE64=
