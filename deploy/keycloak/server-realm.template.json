{
  "realm": "inventory-${IDENTITY_ENVIRONMENT}",
  "displayName": "Inventory Management — ${IDENTITY_ENVIRONMENT}",
  "enabled": true,
  "sslRequired": "all",
  "registrationAllowed": true,
  "registrationEmailAsUsername": true,
  "loginWithEmailAllowed": true,
  "duplicateEmailsAllowed": false,
  "resetPasswordAllowed": true,
  "editUsernameAllowed": false,
  "rememberMe": true,
  "bruteForceProtected": true,
  "verifyEmail": true,
  "loginTheme": "inventory",
  "passwordPolicy": "length(12) and maxLength(128) and digits(1) and upperCase(1) and lowerCase(1) and notUsername(undefined) and notEmail(undefined)",
  "ssoSessionIdleTimeoutRememberMe": 604800,
  "ssoSessionMaxLifespanRememberMe": 2592000,
  "internationalizationEnabled": true,
  "supportedLocales": [
    "en",
    "tr"
  ],
  "defaultLocale": "en",
  "accessTokenLifespan": 300,
  "ssoSessionIdleTimeout": 1800,
  "ssoSessionMaxLifespan": 36000,
  "revokeRefreshToken": true,
  "refreshTokenMaxReuse": 0,
  "roles": {
    "realm": [
      {
        "name": "Admin",
        "description": "Platform administrator: manage companies, memberships and inventory across companies."
      },
      {
        "name": "User",
        "description": "Application user: company membership and company role determine data access."
      }
    ]
  },
  "defaultRoles": [
    "User"
  ],
  "clients": [
    {
      "clientId": "inventory-web",
      "name": "Inventory Web",
      "baseUrl": "${APP_ORIGIN}",
      "enabled": true,
      "protocol": "openid-connect",
      "publicClient": true,
      "standardFlowEnabled": true,
      "implicitFlowEnabled": false,
      "directAccessGrantsEnabled": false,
      "serviceAccountsEnabled": false,
      "redirectUris": [
        "${APP_ORIGIN}/auth/callback"
      ],
      "webOrigins": [
        "${APP_ORIGIN}"
      ],
      "attributes": {
        "pkce.code.challenge.method": "S256",
        "post.logout.redirect.uris": "${APP_ORIGIN}/auth/login"
      },
      "defaultClientScopes": [
        "basic",
        "web-origins",
        "acr",
        "profile",
        "roles",
        "email"
      ],
      "protocolMappers": [
        {
          "name": "inventory-api-audience",
          "protocol": "openid-connect",
          "protocolMapper": "oidc-audience-mapper",
          "config": {
            "included.client.audience": "inventory-api",
            "id.token.claim": "false",
            "access.token.claim": "true"
          }
        }
      ]
    },
    {
      "clientId": "inventory-api",
      "name": "Inventory API",
      "enabled": true,
      "protocol": "openid-connect",
      "bearerOnly": true,
      "standardFlowEnabled": false,
      "directAccessGrantsEnabled": false
    }
  ]
}
