{
  "clientId": "inventory-observability",
  "name": "Inventory system monitoring",
  "enabled": true,
  "protocol": "openid-connect",
  "publicClient": false,
  "secret": "${GRAFANA_OAUTH_SECRET}",
  "standardFlowEnabled": true,
  "implicitFlowEnabled": false,
  "directAccessGrantsEnabled": false,
  "serviceAccountsEnabled": false,
  "redirectUris": ["${GRAFANA_ORIGIN}/observability/login/generic_oauth"],
  "webOrigins": ["${GRAFANA_ORIGIN}"],
  "attributes": {"pkce.code.challenge.method": "S256"},
  "defaultClientScopes": ["profile", "email", "roles"],
  "protocolMappers": [{
    "name": "Admin roles in identity tokens",
    "protocol": "openid-connect",
    "protocolMapper": "oidc-usermodel-realm-role-mapper",
    "config": {"multivalued": "true", "claim.name": "realm_access.roles", "jsonType.label": "String", "id.token.claim": "true", "access.token.claim": "true", "userinfo.token.claim": "true"}
  }]
}
